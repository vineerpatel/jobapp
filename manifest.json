{
  "manifest_version": 3,
  "name": "Job Application Helper (Prototype)",
  "version": "0.1.0",
  "description": "Fill common job application fields from a saved profile.",
  "permissions": ["storage", "scripting", "activeTab"],
  "action": {
    "default_title": "Job Application Helper"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
